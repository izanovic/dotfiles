function p
    cd ~/projects/$argv/
end

complete -c p -a(ls ~/projects)

function op
    cd ~/projects/$argv/ && nvm use lts
    if zellij list-sessions --short | grep "$argv"
        zellij delete-session $argv --force
    end
    zellij -l mono-layout
end

function fe
    set session "$argv (FE)"
    cd ~/projects/$argv || return
    nvm use lts

    set sessions (zellij list-sessions --short 2>/dev/null; or echo "")

    if contains -- "$session" $sessions
        echo yes
        zellij attach "$session"
    else
        echo no
        zellij -s "$session" -l frontend-layout
    end
end

function be
    cd ~/projects/$argv/ && nvm use lts
    zellij attach -l backend-layout --create "$argv (BE)"
end

complete -c op -a(ls ~/projects)

function rr
    set PREV_CMD (history | head -1)
    set PREV_OUTPUT (eval $PREV_CMD)
    set CMD $argv[1]
    echo "Running '$CMD $PREV_OUTPUT'"
    eval "$CMD $PREV_OUTPUT"
end

# Path to temporary clipboard file
set -g FILE_CLIPBOARD "$HOME/.file_clipboard"

function copy
    if test (count $argv) -eq 0
        echo "❌ Usage: copy <file1> [file2 ...]"
        return 1
    end

    set -l copied_paths
    for f in $argv
        if test -e $f
            set -a copied_paths (realpath $f)
        else
            echo "⚠️  File not found: $f"
        end
    end

    if test (count $copied_paths) -gt 0
        printf "%s\n" $copied_paths >$FILE_CLIPBOARD
        echo "📋 Copied "(count $copied_paths)" file(s) → $FILE_CLIPBOARD"
        for f in $copied_paths
            echo "   • $f"
        end
    else
        echo "❌ No valid files copied."
    end
end

function paste
    if not test -f $FILE_CLIPBOARD
        echo "❌ No files copied yet."
        return 1
    end

    set dest (pwd)
    for f in (cat $FILE_CLIPBOARD)
        if not test -e $f
            echo "⚠️  Skipped missing file: $f"
            continue
        end

        set base (basename $f)
        if test (realpath (dirname $f)) = $dest
            echo "⚠️  Skipped (already in this directory): $base"
            continue
        end

        cp -r -n $f $dest
        echo "📎 Pasted: $base → $dest"
    end
end

